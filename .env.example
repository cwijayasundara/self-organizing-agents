# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real keys.
#
# Run agora with these loaded, for example:
#   uv run --env-file .env agora run --roster ... --template ... --brief ...
#   uv run --env-file .env python scripts/smoke_models.py --roster roster.example.yaml
#
# A provider whose key is missing is skipped by the smoke check; a roster that
# uses that provider cannot run until its key is set.

# Fireworks: DeepSeek V4.1 Flash 1017, MiniMax M3.1 Flash, GLM 5.3 Flash
FIREWORKS_API_KEY=

# Anthropic: Claude Haiku 5.5 (claude-haiku-5-5)
ANTHROPIC_API_KEY=

# OpenAI: GPT-6 Luna (gpt-6-luna)
OPENAI_API_KEY=
